{
  "name": "@manta-show/mcp",
  "version": "0.0.8",
  "description": "MCP server for AI agents: capture high-quality screenshots and videos of web pages, Electron apps and CLI tools, ready for README/product docs.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "manta-show": "dist/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "playwright",
    "chromium",
    "screenshot",
    "screen-recording",
    "video",
    "terminal",
    "electron",
    "cli",
    "documentation",
    "readme",
    "developer-tools"
  ],
  "bugs": {
    "url": "https://github.com/marrviin/manta-show/issues"
  },
  "homepage": "https://github.com/marrviin/manta-show#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marrviin/manta-show.git",
    "directory": "packages/mcp"
  },
  "files": [
    "dist",
    "assets",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "tsx --test test/unit.test.ts",
    "test:e2e": "pnpm build && tsx test/e2e.ts",
    "test:unify": "pnpm build && tsx test/unify-stress.ts",
    "test:cli": "pnpm build && tsx test/cli.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "npm:@manta-show/node-pty@1.1.0-beta34.4",
    "playwright": "^1.53.0",
    "zod": "^3.24.0"
  },
  "optionalDependencies": {
    "@manta-show/ffmpeg-darwin-arm64": "6.1.1",
    "@manta-show/ffmpeg-darwin-x64": "6.1.1",
    "@manta-show/ffmpeg-linux-arm64": "6.1.1",
    "@manta-show/ffmpeg-linux-x64": "6.1.1",
    "@manta-show/ffmpeg-win32-x64": "6.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^33.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
